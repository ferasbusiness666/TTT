# =====================================================================
# Cloudflare Pages response headers
# =====================================================================
# Closes findings #6 (no HSTS), #7 (clickjacking), #8 (no CSP) and #9
# (Access-Control-Allow-Origin: *) from docs/09-security-stress-test.md.
#
# ABOUT THE CSP: script-src has to keep 'unsafe-inline' for now, because
# every page in this site carries inline <script> blocks and inline
# onclick handlers — dropping it would break the whole site until those
# are refactored out. That's a real limitation, BUT the policy still
# breaks the attack chain the stress test described: connect-src and
# img-src are pinned to known hosts, so an injected script cannot send a
# stolen token anywhere (fetch/XHR/beacon and image-pixel exfiltration
# are both blocked), and script-src blocks loading attacker JS from
# another origin. frame-ancestors 'none' kills the clickjacking route.
#
# If a host is ever added (a new CDN, an embed), it must be added here or
# the browser will silently block it — check the console first when
# something external stops loading.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Access-Control-Allow-Origin: https://tadeleteentalk.pages.dev
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://i.ytimg.com; connect-src 'self' https://ruzsbwgwbneqyvbdmwdb.supabase.co https://api.cloudinary.com https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; media-src 'self' https://res.cloudinary.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Staff screens: noindex as a header as well as a meta tag. The header
# covers cases the meta can't (a non-HTML response, a crawler that reads
# headers first) and costs nothing.
/admin*
  X-Robots-Tag: noindex, nofollow

/editor*
  X-Robots-Tag: noindex, nofollow

/login*
  X-Robots-Tag: noindex, nofollow

# Caching. Cloudflare Pages defaults every response to
# "public, max-age=0, must-revalidate", so a returning reader makes a
# conditional request for the CSS, every JS file and every image on each
# navigation -- a round trip per asset, on the mobile connections that
# matter most here.
#
# CSS and JS (/assets/*) are the exception: they must always match the
# page. Pages themselves are never cached, and these filenames are NOT
# content-hashed (no build step), so any caching here can pair a fresh
# page with yesterday's stylesheet. stale-while-revalidate did exactly
# that on 2026-11-11: the first visit after a deploy got the new editor
# HTML with the old CSS, and an unstyled icon filled the screen. no-cache
# still lets the browser keep its copy, but it checks first (a tiny 304
# when nothing changed), so code and page always match.
#
# Images keep the cached rule: a stale photo can't break a layout. If the
# site ever gains hashed filenames, assets can go to a year with immutable.
/assets/*
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
